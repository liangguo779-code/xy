# Copy this file to `.env` and fill in real values. The .env file is gitignored.
# .env is loaded by the dotenv-maven-plugin in backend/campus-app/pom.xml and
# exposes entries as Maven properties (and therefore as ${...} placeholders in
# backend/campus-app/src/main/resources/application.yml).

# OpenAI-compatible provider (DeepSeek, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional overrides
# AI_HOME=./runtime
# AI_KNOWLEDGE_DIR=
# AI_VECTOR_DIR=
